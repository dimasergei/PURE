{
  "buildCommand": "npm run build",
  "outputDirectory": "public-build",
  "functions": {
    "api/admin-suppliers.js": {
      "includeFiles": "products.js"
    },
    "api/admin-orders.js": {
      "maxDuration": 60
    },
    "api/checkout.js": {
      "includeFiles": "lib/catalog.json",
      "maxDuration": 60
    },
    "api/customer-config.js": {
      "includeFiles": "lib/{catalog.json,public-catalog-shell.html,public-site-facts.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/instagram/callback",
      "destination": "/api/customer-config?instagram=callback"
    },
    {
      "source": "/shop/browse",
      "destination": "/api/customer-config?catalog_view=shop"
    },
    {
      "source": "/coas/search",
      "destination": "/api/customer-config?catalog_view=coas"
    },
    {
      "source": "/cart",
      "destination": "/cart.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/:policy(commercial-terms|corrections-policy|medical-disclaimer|membership-terms|partner-terms|payment-options|privacy-policy|refund-policy|research-documentation|research-use-policy|shipping-policy|shipping-protection|terms-and-conditions)",
      "destination": "/:policy.html"
    },
    {
      "source": "/checkout",
      "destination": "/account.html"
    },
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/account.html"
    },
    {
      "source": "/my-account",
      "destination": "/account.html"
    },
    {
      "source": "/my-account/:path*",
      "destination": "/account.html"
    },
    {
      "source": "/shop",
      "destination": "/shop.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/product/:slug.html"
    },
    {
      "source": "/bulk-orders/checkout",
      "destination": "/account.html"
    },
    {
      "source": "/subscribe-and-save/checkout",
      "destination": "/monthly-orders.html"
    },
    {
      "source": "/bulk-orders",
      "destination": "/bulk-orders.html"
    },
    {
      "source": "/coas",
      "destination": "/coas.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/monthly-orders",
      "destination": "/monthly-orders.html"
    },
    {
      "source": "/gift-cards",
      "destination": "/gift-cards.html"
    },
    {
      "source": "/track-order",
      "destination": "/track-order.html"
    },
    {
      "source": "/partner-program",
      "destination": "/partner-program.html"
    },
    {
      "source": "/memberships",
      "destination": "/memberships.html"
    },
    {
      "source": "/spin-and-save",
      "destination": "/spin-and-save.html"
    },
    {
      "source": "/subscribe-and-save",
      "destination": "/subscribe-and-save.html"
    },
    {
      "source": "/research-builder",
      "destination": "/research-builder.html"
    },
    {
      "source": "/research-checkout",
      "destination": "/research-checkout.html"
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "redirects": [
    {
      "source": "/my-account/subscriptions",
      "destination": "/account/membership",
      "permanent": false
    },
    {
      "source": "/my-account/stack",
      "destination": "/account/membership",
      "permanent": false
    },
    {
      "source": "/account/stack",
      "destination": "/account/membership",
      "permanent": false
    },
    {
      "source": "/account/subscriptions",
      "destination": "/account/membership",
      "permanent": false
    },
    {
      "source": "/research-subscriptions",
      "destination": "/subscribe-and-save",
      "permanent": false
    },
    {
      "source": "/research-checkout.html",
      "destination": "/memberships",
      "permanent": false
    },
    {
      "source": "/research-checkout",
      "destination": "/memberships",
      "permanent": false
    },
    {
      "source": "/research-builder.html",
      "destination": "/subscribe-and-save",
      "permanent": false
    },
    {
      "source": "/research-builder",
      "destination": "/subscribe-and-save",
      "permanent": false
    },
    {
      "source": "/rewards",
      "destination": "/account/points",
      "permanent": false
    },
    {
      "source": "/offers",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/offers.html",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/account/memberships",
      "destination": "/account/membership",
      "permanent": false
    },
    {
      "source": "/my-account/memberships",
      "destination": "/account/membership",
      "permanent": false
    },
    {
      "source": "/storefront-v2.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rewards.html",
      "destination": "/my-account/points",
      "statusCode": 301
    },
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/account.html",
      "destination": "/my-account",
      "statusCode": 301
    },
    {
      "source": "/account",
      "destination": "/my-account",
      "statusCode": 301
    },
    {
      "source": "/bulk-checkout.html",
      "destination": "/bulk-orders/checkout",
      "statusCode": 301
    },
    {
      "source": "/monthly-checkout.html",
      "destination": "/subscribe-and-save/checkout",
      "statusCode": 301
    },
    {
      "source": "/product/:slug.html",
      "destination": "/product/:slug",
      "statusCode": 301
    },
    {
      "source": "/:page(about|bulk-orders|cart|checkout|coas|contact|faq|gift-cards|memberships|monthly-orders|partner-program|shop|spin-and-save|subscribe-and-save|track-order|commercial-terms|corrections-policy|medical-disclaimer|membership-terms|partner-terms|payment-options|privacy-policy|refund-policy|research-documentation|research-use-policy|shipping-policy|shipping-protection|terms-and-conditions).html",
      "destination": "/:page",
      "statusCode": 301
    }
  ]
}
